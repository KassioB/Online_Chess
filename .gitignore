# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.pyc

# banco de contas da versão web
web/chess.db
web/chess.db-*

# build do cliente gerado pelo pygbag (python web/build_client.py)
web/pawnthon/build/
web/pawnthon/build_id.txt

# aplicativo baixável (PyInstaller)
/dist
/build_desktop

# Android (Buildozer)
/.buildozer
/bin
