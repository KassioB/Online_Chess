# Copie este arquivo para ".env" (na mesma pasta) e preencha com os seus dados.
# O .env nunca vai para o GitHub: ele está no .gitignore.

# Endereço do PostgreSQL do Neon (Dashboard do Neon > Connect > copie a "connection string")
DATABASE_URL=postgresql://usuario:senha@ep-exemplo-123456.sa-east-1.aws.neon.tech/neondb?sslmode=require
